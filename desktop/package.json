{
  "name": "pasteleria-maria-desktop",
  "version": "1.0.3",
  "description": "Rosa Delicias - punto de venta, inventario, recetas, producción y encargos (base local y agente de WhatsApp integrados)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "instalador": "node compilar.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pasteleriamaria.desktop",
    "productName": "Rosa Delicias",
    "artifactName": "rosa-delicias-v${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "nativo.js",
      "preload.js",
      "splash.html",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "app-project/backend",
        "filter": [
          "dist/**/*",
          "prisma/migrations/**/*",
          "prisma/schema.prisma",
          "package.json",
          "node_modules/.prisma/**/*",
          "node_modules/@prisma/client/**/*",
          "node_modules/sharp/**/*",
          "node_modules/@img/**/*",
          "node_modules/detect-libc/**/*",
          "node_modules/semver/**/*",
          "node_modules/blake3-wasm/**/*",
          "node_modules/@c4312/blake3-internal/**/*",
          "node_modules/reflect-metadata/**/*",
          "node_modules/class-transformer/**/*",
          "node_modules/class-validator/**/*",
          "node_modules/libphonenumber-js/**/*",
          "node_modules/validator/**/*",
          "!prisma/*.db"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "app-project/frontend/dist"
      },
      {
        "from": "..",
        "to": "app-project",
        "filter": [
          "send_whatsapp_agent.exe",
          "send_whatsapp_agent.ahk"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rosa Delicias"
    },
    "publish": {
      "provider": "github",
      "owner": "RafaelGonzalezG08",
      "repo": "Pasteleria_maria"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
