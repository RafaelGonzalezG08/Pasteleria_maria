<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- La app no tiene Toolbar/ActionBar (tema NoActionBar), asi que el menu
         de opciones del sistema (onCreateOptionsMenu) nunca se ve en pantalla.
         Este boton es el unico punto de entrada real para "Cambiar direccion"
         y "Olvidar certificado" una vez que la app ya esta conectada. -->
    <Button
        android:id="@+id/menuButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⋮"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/boton_menu_circular"
        android:contentDescription="Opciones de conexión" />

    <LinearLayout
        android:id="@+id/setupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#3F2F38"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cafe Shopping"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Dirección de la PC (Configuración → Accede desde el celular)"
            android:textColor="#E5D5DA"
            android:textSize="14sp"
            android:gravity="center" />

        <EditText
            android:id="@+id/addressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://192.168.1.5:5183"
            android:inputType="textUri"
            android:autofillHints="url"
            android:textColor="#FFFFFF"
            android:textColorHint="#B09AA1"
            android:backgroundTint="#E57D90" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Conectar"
            android:backgroundTint="#E57D90"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
