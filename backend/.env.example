# Configuracion del backend para DESARROLLO (npm run start:dev).
# Copia este archivo a ".env" y ajusta los valores. Nunca subas el .env al repo.
#
# La app de escritorio instalada NO usa este archivo: desktop/nativo.js le
# pasa al backend estas variables apuntando a la carpeta de datos del usuario
# (%APPDATA%\pasteleria-maria-desktop\datos) y genera su propio JWT_SECRET.

# ---------- General ----------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos (SQLite) ----------
# Un archivo; se crea y se migra solo al arrancar.
DATABASE_URL="file:./dev.db"

# ---------- Autenticacion ----------
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# ---------- WhatsApp (agente de escritorio) ----------
# Las facturas se envian con send_whatsapp_agent.ahk/.exe corriendo en la PC
# (pega el PNG y el texto en WhatsApp Desktop). Estos valores son opcionales:
# cuanto espera el backend la confirmacion del agente antes de marcar error.
WHATSAPP_AGENT_TIMEOUT_MS=240000
WHATSAPP_AGENT_POLL_MS=1500

# ---------- Impuestos ----------
# Tasa por defecto (0.18 = 18% de ITBIS) si todavia no se configuro el negocio.
# La que manda es la de Configuracion > Datos del negocio.
DEFAULT_TAX_RATE=0.18
