# ---------- General ----------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos ----------
# Formato: postgresql://usuario:password@host:5432/nombre_db
# Esta rama usa SQLite (un archivo), no PostgreSQL. La app de escritorio
# apunta esta variable a los datos del usuario; para desarrollo se usa
# prisma/dev.db, que se crea solo al arrancar.
DATABASE_URL="file:./dev.db"

# ---------- Autenticacion ----------
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# ---------- WhatsApp (agente de escritorio) ----------
# El envio de facturas por WhatsApp ya no usa Twilio: se hace con
# send_whatsapp_agent.ahk corriendo en la PC (pega el PNG y el texto en
# WhatsApp Desktop). Estos valores son opcionales, solo ajustan cuanto
# espera el backend la confirmacion del agente antes de marcar error.
WHATSAPP_AGENT_TIMEOUT_MS=240000
WHATSAPP_AGENT_POLL_MS=1500

# ---------- URL publica del backend ----------
# Necesaria para que el link de la factura en WhatsApp funcione desde el
# celular del cliente: "localhost" solo es accesible desde tu propia PC, no
# desde ningun otro dispositivo. Ver README > "Hacer publica la factura sin
# crear cuentas" para el paso a paso usando un tunel gratis de Cloudflare.
BACKEND_PUBLIC_URL=

# ---------- Puppeteer (generacion de PNG/PDF de facturas) ----------
# En Docker ya se configura solo (ver docker-compose.yml). Si corres el backend
# SIN Docker y quieres usar un Chrome/Chromium propio, descomenta y ajusta esta linea:
# PUPPETEER_EXECUTABLE_PATH=C:\ruta\a\chrome.exe

# ---------- Impuestos ----------
# Tasa por defecto aplicada a nuevas ventas si no se especifica una distinta (0.18 = 18%)
DEFAULT_TAX_RATE=0.18
