// Esquema de base de datos - Rosa Delicias
//
// SQLite no tiene enums: los campos de estado/tipo son texto y sus valores
// validos viven en src/common/enums.ts. Tampoco tiene tipo Json: las listas se
// guardan como texto JSON (ver AuditLog.changes, Client.fechasEspeciales).

generator client {
  provider      = "prisma-client-js"
  // Solo Windows: la app de escritorio nunca corre en otro sistema.
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios ----------

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  // ADMIN | CAJERO | REPOSTERO
  role         String   @default("CAJERO")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sales       Sale[]
  expenses    Expense[]
  auditLogs   AuditLog[]
  movimientos MovimientoInsumo[]
  producciones Produccion[]
  compras     Compra[]
  encargos    Encargo[]
  pagosEncargo EncargoPago[]
  mermasProducto MermaProducto[]

  @@map("users")
}

// ---------- Clientes ----------

model Client {
  id                 String    @id @default(cuid())
  nombre             String
  telefono           String
  email              String?
  direccion          String?
  notas              String?
  // Solo dia y mes importan para el recordatorio; se guarda la fecha completa
  // si el negocio la conoce (el año es opcional, se usa 2000 como relleno).
  cumpleanos         DateTime?
  // Otras fechas especiales (aniversario, cumpleaños de un hijo...).
  // JSON: [{ "descripcion": "Aniversario", "fecha": "2026-05-14" }]
  fechasEspeciales   String?   @map("fechas_especiales")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sales    Sale[]
  debts    ClientDebt[]
  encargos Encargo[]

  @@map("clients")
}

// ---------- Productos terminados ----------

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  nombre         String
  precioUnitario Decimal  @map("precio_unitario")
  // Costo de producir una unidad. Si el producto tiene receta, se recalcula
  // solo con el precio actual de los insumos (ver RecetasService) y al
  // registrar cada produccion. Solo ADMIN lo ve.
  costoUnitario  Decimal  @default(0) @map("costo_unitario")
  stock          Int      @default(0)
  imageUrl       String?  @map("image_url")
  descripcion    String?
  activo         Boolean  @default(true)
  categoriaId    String?  @map("categoria_id")
  // Venta por porcion: este producto es una porcion de `porcionDe` (el
  // pastel entero) y de cada entero salen `porcionesPorUnidad`. Las
  // porciones entran a la existencia al "cortar" un entero (ver
  // ProductsService.cortar), no por produccion.
  porcionDeId        String? @map("porcion_de_id")
  porcionesPorUnidad Int?    @map("porciones_por_unidad")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  saleItems    SaleItem[]
  categoria    Category?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  porcionDe    Product?      @relation("PorcionDe", fields: [porcionDeId], references: [id], onDelete: SetNull)
  porciones    Product[]     @relation("PorcionDe")
  receta       Receta?
  producciones Produccion[]
  encargoItems EncargoItem[]
  mermas       MermaProducto[]

  @@map("products")
  @@index([categoriaId])
}

// Pasteles, panes, bizcochos, postres... (el negocio las define a su gusto).
model Category {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

// Producto terminado que se bota (vencido, dañado, se cayo...).
model MermaProducto {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  cantidad      Int
  // Costo unitario del producto al momento de la merma, para el reporte.
  costoUnitario Decimal  @default(0) @map("costo_unitario")
  motivo        String?
  userId        String?  @map("user_id")
  fecha         DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("mermas_producto")
  @@index([fecha])
}

// ---------- Inventario de insumos ----------

model Insumo {
  id            String   @id @default(cuid())
  nombre        String   @unique
  // INGREDIENTE | MATERIAL (cajas, bases de pastel, velas...)
  tipo          String   @default("INGREDIENTE")
  // Unidad en la que se lleva el stock (g, kg, lb, ml, L, unidad, docena).
  // Las compras y recetas pueden usar otra unidad de la misma familia; se
  // convierte siempre a esta (ver common/unidades.ts).
  unidad        String
  stockActual   Decimal  @default(0) @map("stock_actual")
  stockMinimo   Decimal  @default(0) @map("stock_minimo")
  // Costo por unidad de stock. Promedio ponderado: cada compra lo actualiza.
  costoUnitario Decimal  @default(0) @map("costo_unitario")
  proveedorId   String?  @map("proveedor_id")
  notas         String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  proveedor    Proveedor?          @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  lotes        LoteInsumo[]
  movimientos  MovimientoInsumo[]
  ingredientes RecetaIngrediente[]
  compraItems  CompraItem[]
  consumos     ProduccionConsumo[]

  @@map("insumos")
}

// Cada entrada de un insumo es un lote, con su costo y su vencimiento. Las
// salidas consumen primero el lote que vence antes (y si no vence, el mas
// viejo). stockActual del insumo es siempre la suma de cantidadRestante.
model LoteInsumo {
  id                String    @id @default(cuid())
  insumoId          String    @map("insumo_id")
  cantidadInicial   Decimal   @map("cantidad_inicial")
  cantidadRestante  Decimal   @map("cantidad_restante")
  costoUnitario     Decimal   @default(0) @map("costo_unitario")
  fechaVencimiento  DateTime? @map("fecha_vencimiento")
  fechaEntrada      DateTime  @default(now()) @map("fecha_entrada")
  compraItemId      String?   @map("compra_item_id")

  insumo     Insumo      @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  compraItem CompraItem? @relation(fields: [compraItemId], references: [id], onDelete: SetNull)

  @@map("lotes_insumo")
  @@index([insumoId])
  @@index([fechaVencimiento])
}

// Historial de todo lo que entra y sale de un insumo.
model MovimientoInsumo {
  id            String   @id @default(cuid())
  insumoId      String   @map("insumo_id")
  // ENTRADA | SALIDA | AJUSTE | MERMA | COMPRA | PRODUCCION
  tipo          String
  // Con signo y en la unidad del insumo: + entra, - sale.
  cantidad      Decimal
  costoUnitario Decimal  @default(0) @map("costo_unitario")
  // Stock que quedo despues del movimiento (para leer el historial sin sumar).
  stockResultante Decimal @map("stock_resultante")
  motivo        String?
  produccionId  String?  @map("produccion_id")
  compraId      String?  @map("compra_id")
  userId        String?  @map("user_id")
  fecha         DateTime @default(now())

  insumo     Insumo      @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  produccion Produccion? @relation(fields: [produccionId], references: [id], onDelete: SetNull)
  compra     Compra?     @relation(fields: [compraId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("movimientos_insumo")
  @@index([insumoId])
  @@index([fecha])
  @@index([tipo])
}

// ---------- Recetas ----------

model Receta {
  id                  String   @id @default(cuid())
  nombre              String   @unique
  // true = subreceta (relleno, crema, masa...) que se usa dentro de otras.
  esSubreceta         Boolean  @default(false) @map("es_subreceta")
  // Cuanto sale de una tanda: "24 unidad", "1 unidad", "1500 g", "2 L"...
  rendimiento         Decimal
  unidadRendimiento   String   @map("unidad_rendimiento")
  // Porciones que da una tanda (un pastel = 1 unidad pero 12 porciones). Si
  // es null, el costo por porcion es el costo por unidad de rendimiento.
  porciones           Int?
  tiempoPreparacionMin Int?    @map("tiempo_preparacion_min")
  pasos               String?
  // Margen de ganancia para el precio sugerido. null = el del negocio.
  margenPct           Decimal? @map("margen_pct")
  // Producto terminado que esta receta produce (solo recetas finales).
  productoId          String?  @unique @map("producto_id")
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  producto     Product?            @relation(fields: [productoId], references: [id], onDelete: SetNull)
  ingredientes RecetaIngrediente[] @relation("IngredientesDeReceta")
  usadaEn      RecetaIngrediente[] @relation("SubrecetaUsada")
  producciones Produccion[]

  @@map("recetas")
}

// Linea de una receta: o un insumo, o una subreceta (exactamente uno).
model RecetaIngrediente {
  id          String  @id @default(cuid())
  recetaId    String  @map("receta_id")
  insumoId    String? @map("insumo_id")
  subrecetaId String? @map("subreceta_id")
  cantidad    Decimal
  unidad      String
  orden       Int     @default(0)

  receta    Receta  @relation("IngredientesDeReceta", fields: [recetaId], references: [id], onDelete: Cascade)
  insumo    Insumo? @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  subreceta Receta? @relation("SubrecetaUsada", fields: [subrecetaId], references: [id], onDelete: Restrict)

  @@map("receta_ingredientes")
  @@index([recetaId])
}

// ---------- Produccion ----------

model Produccion {
  id                 String   @id @default(cuid())
  fecha              DateTime @default(now())
  recetaId           String   @map("receta_id")
  // Factor de la receta: 1 = una tanda, 2.5 = dos tandas y media.
  tandas             Decimal
  // Unidades de producto terminado que se sumaron al inventario.
  unidadesProducidas Int      @default(0) @map("unidades_producidas")
  productoId         String?  @map("producto_id")
  costoTotal         Decimal  @default(0) @map("costo_total")
  notas              String?
  userId             String?  @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  receta      Receta              @relation(fields: [recetaId], references: [id], onDelete: Restrict)
  producto    Product?            @relation(fields: [productoId], references: [id], onDelete: SetNull)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  consumos    ProduccionConsumo[]
  movimientos MovimientoInsumo[]

  @@map("producciones")
  @@index([fecha])
}

model ProduccionConsumo {
  id            String  @id @default(cuid())
  produccionId  String  @map("produccion_id")
  insumoId      String  @map("insumo_id")
  // En la unidad del insumo.
  cantidad      Decimal
  costoUnitario Decimal @map("costo_unitario")

  produccion Produccion @relation(fields: [produccionId], references: [id], onDelete: Cascade)
  insumo     Insumo     @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@map("produccion_consumos")
  @@index([produccionId])
}

// ---------- Proveedores y compras ----------

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  insumos Insumo[]
  compras Compra[]

  @@map("proveedores")
}

model Compra {
  id            String   @id @default(cuid())
  fecha         DateTime @default(now())
  proveedorId   String?  @map("proveedor_id")
  numeroFactura String?  @map("numero_factura")
  total         Decimal
  notas         String?
  // Gasto que se registro junto con la compra (para que el flujo de caja la
  // cuente). null si se eligio no registrarla como gasto.
  expenseId     String?  @unique @map("expense_id")
  userId        String?  @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  proveedor   Proveedor?         @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  expense     Expense?           @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  items       CompraItem[]
  movimientos MovimientoInsumo[]

  @@map("compras")
  @@index([fecha])
}

model CompraItem {
  id               String    @id @default(cuid())
  compraId         String    @map("compra_id")
  insumoId         String    @map("insumo_id")
  // Tal como se compro (ej. 2 lb); el lote guarda lo convertido a la unidad del insumo.
  cantidad         Decimal
  unidad           String
  costoTotal       Decimal   @map("costo_total")
  fechaVencimiento DateTime? @map("fecha_vencimiento")

  compra Compra       @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumo Insumo       @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  lotes  LoteInsumo[]

  @@map("compra_items")
}

// ---------- Ventas ----------

model Sale {
  id           String   @id @default(cuid())
  fecha        DateTime @default(now())
  subtotal     Decimal
  impuestos    Decimal  @default(0)
  total        Decimal
  // Porcentaje de descuento sobre el bruto (0-100), ANTES de impuestos.
  descuentoPct Decimal  @default(0) @map("descuento_pct")
  metodoPago   String   @map("metodo_pago")
  userId       String   @map("user_id")
  clientId     String?  @map("client_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user     User         @relation(fields: [userId], references: [id])
  client   Client?      @relation(fields: [clientId], references: [id])
  items    SaleItem[]
  invoice  Invoice?
  payments Payment[]
  debts    ClientDebt[]
  // Encargo que se entrego con esta venta (si vino de un encargo).
  encargo  Encargo?

  @@map("sales")
  @@index([fecha])
  @@index([clientId])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String  @map("sale_id")
  productId      String? @map("product_id")
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario")
  // Copia del costo del producto al momento de la venta, para que el margen
  // historico no cambie si luego cambia el precio de los insumos.
  costoUnitario  Decimal @default(0) @map("costo_unitario")
  total          Decimal

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Invoice {
  id             String    @id @default(cuid())
  saleId         String    @unique @map("sale_id")
  numero         String    @unique
  estado         String    @default("PENDIENTE")
  pdfUrl         String?   @map("pdf_url")
  pngUrl         String?   @map("png_url")
  sentWhatsappAt DateTime? @map("sent_whatsapp_at")
  ultimoError    String?   @map("ultimo_error")

  // Cola de envio por WhatsApp (ver whatsapp-queue.service.ts).
  whatsappEstado         String?   @map("whatsapp_estado") // EN_COLA | ENVIADA | ERROR | null
  whatsappIntentos       Int       @default(0) @map("whatsapp_intentos")
  whatsappProximoIntento DateTime? @map("whatsapp_proximo_intento")
  whatsappMensaje        String?   @map("whatsapp_mensaje")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("invoices")
  @@index([whatsappEstado])
}

// Abono a una venta a credito (ver client-debts).
model Payment {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  amount    Decimal
  fecha     DateTime @default(now())
  metodo    String
  createdAt DateTime @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("payments")
}

model ClientDebt {
  id          String    @id @default(cuid())
  clientId    String    @map("client_id")
  saleId      String?   @map("sale_id")
  amountTotal Decimal   @map("amount_total")
  amountPaid  Decimal   @default(0) @map("amount_paid")
  dueDate     DateTime? @map("due_date")
  status      String    @default("PENDIENTE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("client_debts")
  @@index([clientId])
  @@index([status])
  @@index([saleId])
}

model Expense {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  categoria   String
  descripcion String
  monto       Decimal
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  compra Compra?

  @@map("expenses")
  @@index([fecha])
}

// ---------- Encargos (pedidos de clientes) ----------

// Pedido que un cliente encarga para una fecha: un pastel de cumpleaños, 50
// bizcochos para una fiesta... Todavia no es una venta: se vuelve venta (con
// su factura) al entregarse. Mientras tanto acumula anticipos/abonos.
model Encargo {
  id               String    @id @default(cuid())
  // ENC-2026-00001
  codigo           String    @unique
  clientId         String    @map("client_id")
  fechaEntrega     DateTime  @map("fecha_entrega")
  // DOMICILIO | RETIRO
  tipoEntrega      String    @default("RETIRO") @map("tipo_entrega")
  direccionEntrega String?   @map("direccion_entrega")
  costoEnvio       Decimal   @default(0) @map("costo_envio")
  // PENDIENTE | EN_PRODUCCION | LISTO | ENTREGADO | CANCELADO
  estado           String    @default("PENDIENTE")
  subtotal         Decimal   @default(0)
  impuestos        Decimal   @default(0)
  total            Decimal   @default(0)
  tasaImpuesto     Decimal   @default(0) @map("tasa_impuesto")
  // Suma de los pagos (anticipos/abonos) recibidos.
  abonado          Decimal   @default(0)
  notas            String?
  motivoCancelacion String?  @map("motivo_cancelacion")
  // Venta que se creo al entregarlo.
  saleId           String?   @unique @map("sale_id")
  entregadoAt      DateTime? @map("entregado_at")
  userId           String?   @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  client Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sale   Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  EncargoItem[]
  pagos  EncargoPago[]

  @@map("encargos")
  @@index([estado])
  @@index([fechaEntrega])
  @@index([clientId])
}

model EncargoItem {
  id             String  @id @default(cuid())
  encargoId      String  @map("encargo_id")
  productId      String? @map("product_id")
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario")
  total          Decimal
  // Personalizacion (sobre todo para pasteles).
  tamano         String?
  sabor          String?
  relleno        String?
  decoracion     String?
  mensaje        String?
  fotoReferenciaUrl String? @map("foto_referencia_url")

  encargo Encargo  @relation(fields: [encargoId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("encargo_items")
  @@index([encargoId])
}

// Anticipo o abono recibido por un encargo (incluido el pago final al entregar).
model EncargoPago {
  id        String   @id @default(cuid())
  encargoId String   @map("encargo_id")
  monto     Decimal
  metodo    String
  nota      String?
  userId    String?  @map("user_id")
  fecha     DateTime @default(now())

  encargo Encargo @relation(fields: [encargoId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("encargo_pagos")
  @@index([fecha])
}

// ---------- Auditoria y configuracion ----------

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  userId    String?  @map("user_id")
  // JSON serializado como texto (SQLite no tiene tipo Json).
  changes   String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([entity, entityId])
}

// Perfil unico del negocio (fila singleton) usado en Configuracion.
model BusinessProfile {
  id            String   @id @default(cuid())
  // Nombre viejo a proposito: el codigo crea el perfil con
  // NOMBRE_NEGOCIO_POR_DEFECTO (common/negocio.ts); ver ese archivo.
  nombre        String   @default("Pastelería María")
  logoUrl       String?  @map("logo_url")
  direccion     String?
  telefono      String?
  identifFiscal String?  @map("identif_fiscal")
  // Simbolo de la moneda que se muestra en pantalla y en la factura.
  moneda        String   @default("RD$")
  // Nombre y tasa del impuesto (ITBIS 18% en RD).
  nombreImpuesto String  @default("ITBIS") @map("nombre_impuesto")
  tasaImpuesto  Decimal  @default(0.18) @map("tasa_impuesto")
  // Margen de ganancia por defecto para el precio sugerido de las recetas.
  margenGananciaPct Decimal @default(60) @map("margen_ganancia_pct")
  // Avisos: encargos que se entregan dentro de N dias, insumos que vencen
  // dentro de N dias, cumpleaños de clientes dentro de N dias.
  diasAlertaEncargos    Int @default(2) @map("dias_alerta_encargos")
  diasAlertaVencimiento Int @default(7) @map("dias_alerta_vencimiento")
  diasAlertaCumpleanos  Int @default(7) @map("dias_alerta_cumpleanos")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("business_profile")
}
